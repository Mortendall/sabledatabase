))
name_vector <- names(study_list)
purrr::map(name_vector,
~ duckdb::dbWriteTable(sabledatabase,
name = .,
value = study_list_collapsed[[.]],
overwrite = T
)
)
duckdb::dbWriteTable(sabledatabase,
name = "metadata",
value = metadata_frame, overwrite = T)
duckdb::dbDisconnect(sabledatabase)
